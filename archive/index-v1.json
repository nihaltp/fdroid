        "Video"
      ],
      "suggestedVersionName": "1.3.0",
      "suggestedVersionCode": "7",
      "description": "SBSkip is a SponsorBlock-powered media cleaner for Android.\n\nSelect a local video or audio file, provide the corresponding YouTube URL,\nand SBSkip will retrieve SponsorBlock segments and create a cleaned copy\nwith sponsor segments removed.\n\nFeatures:\n\n* SponsorBlock integration\n* Local video and audio file processing\n* Background processing with WorkManager\n* Material 3 user interface\n* Persistent settings with DataStore\n* FFmpeg-based media trimming\n* No account required\n\nSBSkip processes media locally on the device. No YouTube account or API key\nis required.\n",
      "issueTracker": "https://github.com/nihaltp/SBSkip/issues",
      "license": "GPL-3.0-only",
      "sourceCode": "https://github.com/nihaltp/SBSkip",
      "summary": "Remove SponsorBlock segments from local video and audio files",
      "webSite": "https://github.com/nihaltp/SBSkip",
      "added": 1780085906000,
      "packageName": "com.nihaltp.sbskip",
      "lastUpdated": 1781100954000,
      "localized": {
        "en-US": {
          "name": "SB Skip"
        }
      }
    },
    {
      "authorEmail": "nihaltpnki@gmail.com",
      "authorName": "nihaltp",
      "binaries": "https://github.com/nihaltp/SmartRingtone/releases/download/v{version}/app-universal-release.apk",
      "categories": [
        "Ringtone",
        "System",
        "Utilities"
      ],
      "suggestedVersionName": "1.5.0",
      "suggestedVersionCode": "8",
      "description": "Smart Ringtone automatically changes contact-specific ringtones based on your call history.\n\nThe app tracks missed, rejected, incoming, and outgoing calls, assigning a score to each contact. As a contact's score changes, Smart Ringtone can automatically update their ringtone, helping important callers stand out.\n\nFeatures:\n\n* Automatic contact ringtone assignment\n* Configurable ringtone priority levels\n* Call score tracking based on call activity\n* Support for missed, rejected, incoming, and outgoing calls\n* Contact score management and reset controls\n* Local processing with no account required\n* No internet connection required\n\nSmart Ringtone uses Android's built-in contact ringtone functionality and performs all processing on the device. No call logs, contacts, or personal information are transmitted to external servers.\n\nRequired permissions:\n\n* Contacts - to read and update contact ringtone settings\n* Phone State - to detect call state changes\n* Call Logs - to process call activity and update scores\n",
      "issueTracker": "https://github.com/nihaltp/SmartRingtone/issues",
      "license": "MIT",
      "sourceCode": "https://github.com/nihaltp/SmartRingtone",
      "summary": "Automatically adjust contact ringtones based on call activity",
      "webSite": "https://github.com/nihaltp/SmartRingtone/",
      "added": 1780700986000,
      "packageName": "com.nihaltp.smartringtone",
      "lastUpdated": 1780834747000,
      "localized": {
        "en-US": {
          "name": "Smart Ringtone"
        }
      }
    }
